<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_rounded">

    <TextView android:id="@+id/txtConfirmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Konfirmasi"
        android:textColor="#111B21"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="@font/manrope" />

    <TextView android:id="@+id/txtConfirmMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Apakah kamu yakin?"
        android:textColor="#667781"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        android:fontFamily="@font/manrope" />

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmNegative"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Batal"
            android:textColor="#667781"
            app:cornerRadius="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmPositive"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            android:text="Ganti"
            android:textColor="#FFFFFF"
            android:backgroundTint="#075E54"
            app:cornerRadius="20dp" />
    </LinearLayout>
</LinearLayout>
