<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="20dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Verifikasi nomor" android:textColor="#111B21" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/txtPhone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Kode dikirim ke +62..." android:textColor="#667781" android:textSize="13sp" />
    <TextView android:id="@+id/txtOtpHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Dev OTP: -" android:textColor="#075E54" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />

    <!-- WA-style 6 kotak OTP -->
    <LinearLayout android:id="@+id/otpContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal" android:gravity="center" android:weightSum="6">
        <EditText android:id="@+id/otp1" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/bg_otp_box" android:gravity="center" android:inputType="number" android:maxLength="1" android:textSize="22sp" android:textColor="#111B21" android:fontFamily="monospace" />
        <EditText android:id="@+id/otp2" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/bg_otp_box" android:gravity="center" android:inputType="number" android:maxLength="1" android:textSize="22sp" android:textColor="#111B21" android:fontFamily="monospace" />
        <EditText android:id="@+id/otp3" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/bg_otp_box" android:gravity="center" android:inputType="number" android:maxLength="1" android:textSize="22sp" android:textColor="#111B21" android:fontFamily="monospace" />
        <EditText android:id="@+id/otp4" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/bg_otp_box" android:gravity="center" android:inputType="number" android:maxLength="1" android:textSize="22sp" android:textColor="#111B21" android:fontFamily="monospace" />
        <EditText android:id="@+id/otp5" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/bg_otp_box" android:gravity="center" android:inputType="number" android:maxLength="1" android:textSize="22sp" android:textColor="#111B21" android:fontFamily="monospace" />
        <EditText android:id="@+id/otp6" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/bg_otp_box" android:gravity="center" android:inputType="number" android:maxLength="1" android:textSize="22sp" android:textColor="#111B21" android:fontFamily="monospace" />
    </LinearLayout>
    <!-- Hidden input untuk kompatibilitas lama (tidak dipakai) -->
    <EditText android:id="@+id/inputOtp" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:inputType="number" android:maxLength="6" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="24dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnVerif" android:layout_width="match_parent" android:layout_height="match_parent" android:text="Verifikasi" app:cornerRadius="12dp" android:backgroundTint="#075E54" />
        <ProgressBar android:id="@+id/progressVerif" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:visibility="gone" android:indeterminateTint="#FFFFFF" />
    </FrameLayout>
    <TextView android:id="@+id/btnResend" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_gravity="center" android:text="Kirim ulang OTP" android:textColor="#075E54" android:textSize="13sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
    <TextView android:id="@+id/txtCountdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="6dp" android:text="Kirim ulang dalam 60s" android:textColor="#8696A0" android:textSize="12sp" android:visibility="gone" />
    <TextView android:id="@+id/txtExpiry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="4dp" android:text="OTP berlaku 05:00" android:textColor="#E65100" android:textSize="11sp" android:alpha="0.9" />
    <ProgressBar android:id="@+id/progressResend" android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:layout_marginTop="8dp" android:visibility="gone" android:indeterminateTint="#075E54" />
    <TextView android:id="@+id/btnGantiNomor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="16dp" android:text="Salah nomor? Ganti nomor" android:textColor="#667781" android:textSize="13sp" android:clickable="true" android:focusable="true" android:padding="8dp" />
</LinearLayout>
