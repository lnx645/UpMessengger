<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="20dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Masukkan nomor HP" android:textColor="#111B21" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="UpMessenger akan mengirim SMS berisi kode verifikasi 6 digit." android:textColor="#667781" android:textSize="13sp" android:lineSpacingExtra="2dp" />
    <View android:layout_width="match_parent" android:layout_height="12dp" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:boxStrokeColor="#075E54" app:hintEnabled="true" android:hint="Nomor HP (contoh: +62 81234567890)">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:textSize="16sp" android:letterSpacing="0.02" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Dev: OTP akan tampil di layar berikutnya (tanpa SMS beneran)" android:textColor="#8696A0" android:textSize="11sp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="24dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnKirimOtp" android:layout_width="match_parent" android:layout_height="match_parent" android:text="Kirim OTP" app:cornerRadius="12dp" android:backgroundTint="#075E54" />
        <ProgressBar android:id="@+id/progressKirimOtp" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:visibility="gone" android:indeterminateTint="#FFFFFF" />
    </FrameLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnDevSkip" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="12dp" android:text="Lewati (dev)" android:textColor="#075E54" app:strokeColor="#075E54" app:cornerRadius="12dp" />
</LinearLayout>
