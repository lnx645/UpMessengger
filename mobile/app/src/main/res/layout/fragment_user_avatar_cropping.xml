<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Toolbar WA-style dark -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarCrop"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#000000"
        app:layout_constraintTop_toTopOf="parent"
        android:elevation="0dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="horizontal" android:gravity="center_vertical">

            <ImageView android:id="@+id/btnCloseCrop"
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@drawable/ic_close"
                android:contentDescription="Tutup"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp" />

            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Potong foto"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:letterSpacing="-0.01" />

            <TextView android:id="@+id/btnRotate"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="Putar"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:background="@drawable/bg_toast"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Crop area square -->
    <FrameLayout
        android:id="@+id/cropContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarCrop"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="1:1">

        <ImageView
            android:id="@+id/imgCrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="matrix"
            android:background="#000000" />

        <com.upme.messenger.presentation.avatar.CropOverlayView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:text="Cubit untuk zoom • Seret untuk geser"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/manrope"
            android:background="#66000000"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="4dp" android:paddingBottom="4dp"
            android:elevation="2dp" />

    </FrameLayout>

    <!-- Bottom bar WA-style dark -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="#000000"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBatal"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:text="Batal"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/manrope"
            app:strokeColor="#FFFFFF"
            app:cornerRadius="24dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimpan"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:text="Simpan"
            android:textColor="#075E54"
            android:fontFamily="@font/manrope"
            android:backgroundTint="#FFFFFF"
            app:cornerRadius="24dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
