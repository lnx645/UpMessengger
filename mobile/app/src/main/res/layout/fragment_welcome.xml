<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:gravity="center"
    android:padding="24dp">

    <ImageView android:layout_width="120dp" android:layout_height="120dp" android:src="@drawable/ic_chat_large" android:alpha="0.9" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Selamat datang di UpMessenger" android:textColor="#111B21" android:textSize="22sp" android:textStyle="bold" android:gravity="center" />
    <TextView android:layout_width="280dp" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Pesan aman, cepat, dan terenkripsi. Verifikasi nomor HP untuk memulai." android:textColor="#667781" android:textSize="14sp" android:gravity="center" android:lineSpacingExtra="3dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnMulai" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="32dp" android:text="Setuju dan Lanjutkan" android:textSize="15sp" app:cornerRadius="12dp" android:backgroundTint="#075E54" />
    <TextView android:layout_width="260dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Dengan melanjutkan, kamu menyetujui Syarat dan Kebijakan Privasi." android:textColor="#8696A0" android:textSize="11sp" android:gravity="center" />
</LinearLayout>
