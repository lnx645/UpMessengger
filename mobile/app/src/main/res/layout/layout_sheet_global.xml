<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded"
    android:paddingBottom="24dp">

    <View android:layout_width="40dp" android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_sheet_handle" />

    <ImageView android:id="@+id/imgSheetIcon"
        android:layout_width="56dp" android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_chat_large"
        android:background="@drawable/bg_icon_green"
        android:padding="14dp"
        android:visibility="gone" />

    <TextView android:id="@+id/txtSheetTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:text="Judul"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="@font/manrope"
        android:gravity="center" />

    <TextView android:id="@+id/txtSheetMessage"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        android:text="Pesan detail sheet global."
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:lineSpacingExtra="2dp" />

    <TextView android:id="@+id/txtSheetCountdown"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text=""
        android:textColor="#E65100"
        android:textSize="12sp"
        android:fontFamily="@font/manrope"
        android:visibility="gone"
        android:background="#FFF3E0"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="6dp" android:paddingBottom="6dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetPrimary"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:text="Kirim"
            style="@style/Widget.UpMe.Button.Primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetSecondary"
            style="@style/Widget.UpMe.Button.Outlined"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="Batal" />
    </LinearLayout>
</LinearLayout>
