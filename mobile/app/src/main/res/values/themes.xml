<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UpMessenger" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/upme_green_dark</item>
        <item name="colorPrimaryContainer">@color/upme_green_light</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/upme_green</item>
        <item name="android:statusBarColor">@color/upme_green_dark</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>
    <style name="TextAppearance.UpMessenger" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>
    <style name="ThemeOverlay.App.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Material3.BottomSheet</item>
    </style>
    <!-- Reusable button styles — U6: ganti warna brand cukup di sini -->
    <style name="Widget.UpMe.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/upme_green_dark</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:fontFamily">@font/manrope_medium</item>
    </style>
    <style name="Widget.UpMe.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/upme_dark</item>
        <item name="android:textColor">@color/upme_dark</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:fontFamily">@font/manrope_medium</item>
    </style>
    <style name="Widget.UpMe.Button.Primary.Pill" parent="Widget.UpMe.Button.Primary">
        <item name="cornerRadius">18dp</item>
    </style>
</resources>
